[Unit]
Description=Token Annihilation Dashboard (Ollama / vLLM / llama.cpp token counter)
After=network-online.target

[Service]
# After a successful update this process exits. Restart= starts the new version.
# A copy started by hand reloads itself instead, so Restart= is not required for the update.
WorkingDirectory=%h/token-annihilation-dashboard
# Uncomment and edit what you use (see README):
# Ollama :11435 runs by default. vLLM :8001 opens once vLLM answers on 8000.
# llama.cpp is counted by reading llama-server's log (read only). Default is ~/pixpilot/run/server.log.
# A missing file is fine. Set LLAMA_LOG empty to turn the tail off and use the automatic :8081 proxy instead.
# Environment=LLAMA_LOG=%h/pixpilot/run/server.log
# Environment=LLAMA_LOG=
# To list your own proxies instead (started right away, e.g. vLLM + NVIDIA NIM):
# Environment=OPENAI_PROXIES=vllm:8001=127.0.0.1:8000,nim:8002=127.0.0.1:9000
# llama.cpp only, proxy fixed on 8081 (server stays on 8080, clients use 8081). Turn the log tail off too:
# Environment=LLAMA_LOG=
# Environment=OPENAI_PROXIES=llamacpp:8081=127.0.0.1:8080
# Environment=STATS_DB=%h/token-annihilation-dashboard/stats.db
# Environment=OLLAMA_PROXY=0
# Environment=DASH_BIND=127.0.0.1 PROXY_PORT=11435 DASH_PORT=11480
ExecStart=/usr/bin/python3 %h/token-annihilation-dashboard/token_annihilator.py
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
